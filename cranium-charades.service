[Unit]
Description=Cranium Charades - Forehead word guessing game
After=network.target
RequiresMountsFor=/mnt/data

[Service]
Type=simple
User=dhughes
WorkingDirectory=/mnt/data/apps/cranium-charades
ExecStart=/mnt/data/apps/cranium-charades/venv/bin/python app.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
